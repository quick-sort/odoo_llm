<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_eval_metric_list" model="ir.ui.view">
        <field name="name">llm.knowledge.eval.metric.list</field>
        <field name="model">llm.knowledge.eval.metric</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="implementation" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_llm_knowledge_eval_metric_form" model="ir.ui.view">
        <field name="name">llm.knowledge.eval.metric.form</field>
        <field name="model">llm.knowledge.eval.metric</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="implementation" />
                        <field name="sequence" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_llm_knowledge_eval_metric" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">llm.knowledge.eval.metric</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
