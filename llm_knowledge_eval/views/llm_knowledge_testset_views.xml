<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_knowledge_testset_form" model="ir.ui.view">
        <field name="name">llm.knowledge.testset.form</field>
        <field name="model">llm.knowledge.testset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="action_view_items"
              type="object"
              class="oe_stat_button"
              icon="fa-list"
            >
                            <field name="item_count" widget="statinfo" string="Test Cases" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Test Set Name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="collection_id" options="{'no_create': True}" />
                            <field
                name="resource_ids"
                widget="many2many_tags"
                options="{'no_create': True}"
              />
                            <field name="source" readonly="1" />
                        </group>
                        <group>
                            <field name="state" widget="badge" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field
                name="description"
                nolabel="1"
                placeholder="Test set description..."
              />
                        </page>
                        <page name="test_cases" string="Test Cases">
                            <field name="item_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="question" />
                                    <field name="query_type" optional="show" />
                                    <field name="reference_answer" optional="hide" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_llm_knowledge_testset_list" model="ir.ui.view">
        <field name="name">llm.knowledge.testset.list</field>
        <field name="model">llm.knowledge.testset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="collection_id" />
                <field name="item_count" />
                <field name="source" />
                <field name="state" widget="badge" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_llm_knowledge_testset_search" model="ir.ui.view">
        <field name="name">llm.knowledge.testset.search</field>
        <field name="model">llm.knowledge.testset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="collection_id" />
                <field name="source" />
                <filter
          string="Archived"
          name="inactive"
          domain="[('active', '=', False)]"
        />
                <filter
          string="Collection"
          name="group_by_collection"
          domain="[]"
          context="{'group_by': 'collection_id'}"
        />
            </search>
        </field>
    </record>

    <record id="action_llm_knowledge_testset" model="ir.actions.act_window">
        <field name="name">Test Sets</field>
        <field name="res_model">llm.knowledge.testset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first RAG test set</p>
            <p
      >Test sets hold question / reference-answer pairs used to evaluate a knowledge collection, regardless of which tool generated them.</p>
        </field>
    </record>

    <record id="view_llm_knowledge_testset_item_list" model="ir.ui.view">
        <field name="name">llm.knowledge.testset.item.list</field>
        <field name="model">llm.knowledge.testset.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="testset_id" optional="hide" />
                <field name="question" />
                <field name="query_type" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_llm_knowledge_testset_item_form" model="ir.ui.view">
        <field name="name">llm.knowledge.testset.item.form</field>
        <field name="model">llm.knowledge.testset.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="testset_id" options="{'no_create': True}" />
                        <field name="query_type" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                    <group string="Question">
                        <field name="question" nolabel="1" />
                    </group>
                    <group string="Reference Answer">
                        <field name="reference_answer" nolabel="1" />
                    </group>
                    <group string="Reference Contexts">
                        <field name="reference_contexts" nolabel="1" />
                    </group>
                    <group string="Source Documents">
                        <field
              name="source_resource_ids"
              nolabel="1"
              widget="many2many_tags"
            />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
