<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="screen_profile_list" model="ir.ui.view">
            <field name="name">screen.profile.list</field>
            <field name="model">screen.profile</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="rule_count"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="screen_profile_form" model="ir.ui.view">
            <field name="name">screen.profile.form</field>
            <field name="model">screen.profile</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Profile name"/></h1>
                        </div>
                        <separator string="Applicability"/>
                        <field name="description" nolabel="1"
                               placeholder="When this profile should be applied..."/>
                        <separator string="Rules"/>
                        <field name="rule_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="requirement"/>
                                <field name="is_required" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="screen_profile_search" model="ir.ui.view">
            <field name="name">screen.profile.search</field>
            <field name="model">screen.profile</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_screen_profile" model="ir.actions.act_window">
            <field name="name">Screening Profiles</field>
            <field name="res_model">screen.profile</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>
    </data>
</odoo>
